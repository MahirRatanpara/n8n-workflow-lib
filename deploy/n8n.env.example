# =============================================================================
# n8n bootstrap configuration
# =============================================================================
# Copy this file to `n8n.env`, fill in the values, then run:
#   sudo ./deploy/n8n-bootstrap.sh
#
# The script reads ONLY from n8n.env (fully unattended). It never prompts.
# Keep n8n.env private — it contains secrets. It is git-ignored by default.
# =============================================================================

# --- Required ----------------------------------------------------------------

# The domain that will point at this VM (an A record must already resolve to
# this VM's public IP before you run the script — HTTPS issuance depends on it).
DOMAIN="n8n-job-switch.cloud"

# Email used for the Let's Encrypt account and expiry notices.
LETSENCRYPT_EMAIL="you@example.com"

# n8n encryption key. Encrypts stored credentials. MUST stay identical across
# reinstalls or your saved credentials become unreadable.
# Leave EMPTY to have the script generate one and save it to N8N_USER_FOLDER;
# back it up somewhere safe the first time.
N8N_ENCRYPTION_KEY=""

# --- Optional (sensible defaults) --------------------------------------------

# System user the n8n service runs as. Created if it does not exist.
N8N_SERVICE_USER="n8n"

# Where n8n stores its data + SQLite DB (owned by N8N_SERVICE_USER).
N8N_USER_FOLDER="/opt/n8n"

# Internal HTTP port n8n listens on (nginx proxies 443 -> this). Not public.
N8N_PORT="5678"

# Timezone for schedule triggers, e.g. Asia/Kolkata, America/New_York.
GENERIC_TIMEZONE="UTC"

# Pin a specific n8n version, e.g. "1.70.0". Empty = latest.
N8N_VERSION=""

# Node.js major version to install via NodeSource.
NODE_MAJOR="20"

# Set to "true" to skip the DNS-resolves-to-this-VM check (not recommended;
# certbot will fail if the domain doesn't actually point here).
SKIP_DNS_CHECK="false"

# Optional extra HTTP basic-auth in front of n8n's own login. Leave BASIC_AUTH
# empty to disable. If enabled, set both user and password.
BASIC_AUTH="false"
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""
