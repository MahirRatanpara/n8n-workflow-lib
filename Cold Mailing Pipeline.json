      "id": "a708f13c-21f9-44d9-a3f8-24c02bfcedb0",
      "name": "Get Cold Mailing Rows",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1312,
        720
      ],
      "typeVersion": 4.6,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "IJGwJa8hH4IF7wFD",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Build a template lookup keyed by TemplateName.\n// NOTE: TemplateID T006 is duplicated in the Templates sheet (LinkedIn Connection\n// Note + Recruiter Mail), and the Cold Mailing \"TemplateId\" column actually holds\n// a TemplateName (\"Recruiter Mail\", \"Follow-Up 2 (Final)\"), so match on name, not ID.\n// \"LinkedIn Connection Note\" has an empty Subject and is not a mail template —\n// picking it will be rejected downstream rather than drafted blank.\nconst templates = {};\nfor (const t of $('Get Templates').all()) {\n  const name = (t.json.TemplateName || '').toString().trim();\n  if (name) templates[name.toLowerCase()] = t.json;\n}\n\nconst DAY = 24 * 60 * 60 * 1000;\nconst COLD_AFTER_DAYS = 4;   // Sent        -> Ready for Followup\nconst FOLLOW_AFTER_DAYS = 5; // FollowUp Sent -> Ready for Followup\nconst now = new Date();\n\n// Sheets can hand a date back as an ISO string, a locale string, or a serial\n// number, depending on the column's format. Accept all three.\nfunction parseTs(v) {\n  if (v === null || v === undefined || v === '') return null;\n  if (v instanceof Date) return v;\n  if (typeof v === 'number') return new Date(Date.UTC(1899, 11, 30) + v * DAY);\n  const s = v.toString().trim();\n  if (!s) return null;\n  const dmy = s.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{4})/);\n  if (dmy) return new Date(Number(dmy[3]), Number(dmy[2]) - 1, Number(dmy[1]));\n  const parsed = Date.parse(s);\n  return isNaN(parsed) ? null : new Date(parsed);\n}\n\nfunction fill(str, ctx) {\n  return (str || '').toString()\n    .replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (_, k) => (ctx[k] === undefined ? '' : ctx[k]).toString());\n}\n\nconst out = [];\nconst seen = new Set();\n\nfor (const item of $input.all()) {\n  const r = item.json;\n\n  // Guard: an upstream node that fans out makes the Sheets read run once per\n  // input item, so every row arrives N times. One draft per row, always.\n  if (seen.has(r.row_number)) continue;\n  seen.add(r.row_number);\n\n  const status = (r['Status'] || '').toString().trim();\n  const key = status.toLowerCase();\n\n  const fullName = (r['Recruiter Name'] || '').toString().trim();\n  const parts = fullName.split(/\\s+/).filter(Boolean);\n\n  // Cold Mailing column names differ from the Templates placeholder names.\n  const ctx = {\n    FirstName: parts[0] || '',\n    LastName: parts.slice(1).join(' '),\n    FullName: fullName,\n    Email: (r['Recruiter Email'] || '').toString().trim(),\n    Company: (r['Job Company'] || '').toString().trim(),\n    Role: (r['Job Title'] || '').toString().trim(),\n    JobURL: (r['Job Link'] || '').toString().trim(),\n    ResumeURL: (r['ResumeLink'] || '').toString().trim(),\n    LinkedInURL: '',\n    CustomNote: '',\n  };\n\n  const threadId = (r['ThreadId'] || '').toString().trim();\n  const ts = parseTs(r['Timestamp']);\n  const ageDays = ts ? (now - ts) / DAY : null;\n\n  const base = {\n    rowNumber: r.row_number,\n    status,\n    email: ctx.Email,\n    recruiter: fullName,\n    company: ctx.Company,\n    resumeLink: ctx.ResumeURL,\n    threadId,\n  };\n\n  const skip = (reason) => out.push({ json: { ...base, action: 'skip', reason } });\n\n  // The TemplateId column drives every draft, cold and followup alike: whatever\n  // template name you put in that column is what gets written. Change it to\n  // \"Follow-Up 2 (Final)\" when you want the second followup to differ.\n  const resolveTemplate = () => {\n    const tplName = (r['TemplateId'] || '').toString().trim();\n    if (!tplName) return { error: 'TemplateId is empty' };\n    const tpl = templates[tplName.toLowerCase()];\n    if (!tpl) return { error: 'Template \"' + tplName + '\" not found in Templates sheet' };\n    const subject = fill(tpl.Subject, ctx);\n    const body = fill(tpl.Body, ctx);\n    // Never hand Gmail a blank subject or body — surface it as a skip instead of\n    // drafting an empty message that looks like it worked. \"LinkedIn Connection\n    // Note\" has no Subject at all, so selecting it is always a mistake.\n    if (!body.trim()) return { error: 'Template \"' + tplName + '\" has an empty Body column' };\n    if (!subject.trim()) return { error: 'Template \"' + tplName + '\" has an empty Subject column' };\n    return { tplName, subject, body };\n  };\n\n  if (key === 'pending') {\n    if (!ctx.Email) { skip('Recruiter Email is empty'); continue; }\n    if (!ctx.ResumeURL) { skip('ResumeLink is empty'); continue; }\n    const t = resolveTemplate();\n    if (t.error) { skip(t.error); continue; }\n    out.push({ json: { ...base, action: 'draft_cold',\n                       templateName: t.tplName, subject: t.subject, body: t.body } });\n\n  } else if (key === 'sent') {\n    if (ageDays === null) { skip('Timestamp missing or unparseable'); continue; }\n    if (ageDays >= COLD_AFTER_DAYS) out.push({ json: { ...base, action: 'mark_ready' } });\n    else skip('Only ' + ageDays.toFixed(1) + 'd since sent (needs ' + COLD_AFTER_DAYS + ')');\n\n  } else if (key === 'followup') {\n    if (!threadId) { skip('Status is FollowUp but ThreadId is empty'); continue; }\n    if (!ctx.Email) { skip('Recruiter Email is empty'); continue; }\n    const t = resolveTemplate();\n    if (t.error) { skip(t.error); continue; }\n    out.push({ json: { ...base, action: 'draft_followup',\n                       templateName: t.tplName, subject: t.subject, body: t.body } });\n\n  } else if (key === 'followup sent') {\n    if (ageDays === null) { skip('Timestamp missing or unparseable'); continue; }\n    if (ageDays >= FOLLOW_AFTER_DAYS) out.push({ json: { ...base, action: 'mark_ready' } });\n    else skip('Only ' + ageDays.toFixed(1) + 'd since followup (needs ' + FOLLOW_AFTER_DAYS + ')');\n\n  } else {\n    // \"Ready for Followup\" lands here on purpose: it is the manual gate.\n    skip('Status \"' + status + '\" is not actionable');\n  }\n}\n\nreturn out;"
      },
